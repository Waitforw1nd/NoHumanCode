          { "seq": 6, "sessionId": "s-batch", "runId": "run-batch-1", "event": { "type": "toolCall", "callId": "call_read_1", "name": "read", "args": { "path": "package.json" }, "batchId": "batch-1", "batchIndex": 0, "batchSize": 3 } },
          { "seq": 7, "sessionId": "s-batch", "runId": "run-batch-1", "event": { "type": "toolCall", "callId": "call_load_1", "name": "loadTools", "args": { "names": ["messageBot"] }, "batchId": "batch-1", "batchIndex": 1, "batchSize": 3 } },
          { "seq": 8, "sessionId": "s-batch", "runId": "run-batch-1", "event": { "type": "usage", "usage": { "input": 1200, "output": 68, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 1268 } } },
          { "seq": 9, "sessionId": "s-batch", "runId": "run-batch-1", "event": { "type": "entry", "revision": 3, "entry": { "id": "<ENTRY_ID:a1>", "parentId": "<ENTRY_ID:u1>", "timestamp": "<TS>", "type": "message", "role": "assistant", "content": [{ "type": "toolCall", "callId": "call_read_1", "name": "read", "args": { "path": "package.json" } }, { "type": "toolCall", "callId": "call_load_1", "name": "loadTools", "args": { "names": ["messageBot"] } }, { "type": "toolCall", "callId": "call_msg_1", "name": "messageBot", "args": { "to": "helper", "text": "准备同步" } }], "metadata": { "stopReason": "toolUse", "responseId": "<OPAQUE>" } } } },
