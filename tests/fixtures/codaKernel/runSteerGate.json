{
  "name": "runSteerGate",
  "description": "beforeModelTurn 暂停/恢复、工具等待期间安全点 steer（含 POST /steer 与 POST /entries deliverAs=steer 保留完整 customMessage）、one-at-a-time 分轮注入、无工具调用回合不丢弃排队 steer，以及 afterTurn 闸门早停（finish）。",
  "steps": [
    {
      "request": {
        "method": "PUT",
        "path": "/api/kernel/sessions/s-steer",
        "headers": { "x-coda-token": "<TOKEN>" },
        "body": {
          "cwd": "C:/Users/me/.coda/cd-1f2e",
          "systemPrompt": "你是 Coda。",
          "model": { "modelId": "gpt-5.2", "protocol": "openai-responses", "contextWindow": 400000, "maxOutputTokens": 128000, "thinkingLevel": "medium" },
          "tools": [
            { "name": "read", "description": "读取工作区文件", "parameters": { "type": "object", "properties": { "path": { "type": "string" } }, "required": ["path"] }, "label": "读取文件", "executionMode": "parallel" },
            { "name": "requestInput", "description": "向用户发起交互式提问卡片", "parameters": { "type": "object", "properties": { "prompt": { "type": "string" } }, "required": ["prompt"] }, "label": "请求输入", "executionMode": "sequential" }
          ],
          "activeToolNames": ["read", "requestInput"],
          "compaction": { "enabled": true, "keepRecentTokens": 20000 },
          "steeringMode": "one-at-a-time",
          "gates": ["beforeModelTurn", "afterTurn"],
          "history": {
            "leafId": null,
            "entries": []
          }
        }
      },
      "response": { "status": 201, "body": { "sessionId": "s-steer", "revision": 1, "leafId": null, "status": "idle" } }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/kernel/sessions/s-steer/runs",
        "headers": { "x-coda-token": "<TOKEN>" },
        "body": {
          "runId": "run-steer-1",
          "baseRevision": 1,
          "model": { "modelId": "gpt-5.2" },
          "content": [{ "type": "text", "text": "帮我看下 src/api.ts" }],
          "thinkingLevel": "medium",
          "maxRequests": 64,
          "modelProxy": { "baseUrl": "http://127.0.0.1:61234/m/run-steer-1", "token": "<PROXY_TOKEN>", "protocol": "openai-responses" }
        }
      },
      "expectUpstream": [
        {
          "method": "POST",
          "url": "http://127.0.0.1:61234/m/run-steer-1/responses",
          "headers": { "authorization": "Bearer <PROXY_TOKEN>" },
          "bodyIncludes": { "model": "gpt-5.2", "stream": true },
          "bodyAssertions": [
            "Turn 1 仅在 beforeModelTurn 闸门放行后才发起模型请求"
          ]
        },
        {
          "method": "POST",
          "url": "http://127.0.0.1:61234/m/run-steer-1/responses",
          "headers": { "authorization": "Bearer <PROXY_TOKEN>" },
          "bodyIncludes": { "model": "gpt-5.2", "stream": true },
          "bodyAssertions": [
            "Turn 2 包含闭合的 call_read_1 工具结果及第一条 steer（顺便检查下类型定义），尚未包含第二条 codaGroupPost steer"
          ]
        },
        {
          "method": "POST",
          "url": "http://127.0.0.1:61234/m/run-steer-1/responses",
          "headers": { "authorization": "Bearer <PROXY_TOKEN>" },
          "bodyIncludes": { "model": "gpt-5.2", "stream": true },
          "bodyAssertions": [
            "Turn 3 由排队的第二条 customMessage steer（codaGroupPost）触发，即使 Turn 2 未产生工具调用"
          ]
        }
      ],
      "interactions": [
        {
          "afterSeq": 5,
          "note": "宿主持有 beforeModelTurn 闸门实现暂停，随后答复 continue 恢复 Turn 1",
          "request": {
            "method": "POST",
            "path": "/api/kernel/sessions/s-steer/runs/run-steer-1/gates/<GATE_ID:g1>",
            "headers": { "x-coda-token": "<TOKEN>" },
            "body": { "action": "continue" }
          },
          "response": { "status": 200, "body": { "accepted": true } }
        },
        {
          "afterSeq": 13,
          "note": "在等待 call_read_1 结果期间排入第一条普通 steer",
          "request": {
            "method": "POST",
            "path": "/api/kernel/sessions/s-steer/runs/run-steer-1/steer",
            "headers": { "x-coda-token": "<TOKEN>" },
            "body": { "content": [{ "type": "text", "text": "顺便检查下类型定义" }] }
