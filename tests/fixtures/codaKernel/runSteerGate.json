          "request": {
            "method": "POST",
            "path": "/api/kernel/sessions/s-steer/entries",
            "headers": { "x-coda-token": "<TOKEN>" },
            "body": {
              "entry": {
                "type": "customMessage",
                "name": "codaGroupPost",
                "content": [{ "type": "text", "text": "群成员补充：已更新接口" }],
                "display": false,
                "includeInSummary": true
              },
              "deliverAs": "steer"
            }
          },
          "response": { "status": 202, "body": { "queued": true } }
        },
        {
          "afterSeq": 13,
          "note": "宿主提交 call_read_1 结果以闭合 batch-1",
          "request": {
            "method": "POST",
            "path": "/api/kernel/sessions/s-steer/runs/run-steer-1/tool-results",
            "headers": { "x-coda-token": "<TOKEN>" },
            "body": {
              "callId": "call_read_1",
              "result": { "content": [{ "type": "text", "text": "export interface ApiRes { ok: boolean }" }], "details": null, "isError": false }
