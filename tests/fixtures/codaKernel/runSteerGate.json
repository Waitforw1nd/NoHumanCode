            "method": "POST",
            "path": "/api/kernel/sessions/s-steer/runs/run-steer-1/gates/<GATE_ID:g6>",
            "headers": { "x-coda-token": "<TOKEN>" },
            "body": { "action": "finish" }
          },
          "response": { "status": 200, "body": { "accepted": true } }
        }
