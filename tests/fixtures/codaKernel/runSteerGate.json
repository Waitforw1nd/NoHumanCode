          "response": { "status": 200, "body": { "accepted": true } }
        },
        {
          "afterSeq": 22,
          "note": "Turn 2 beforeModelTurn 闸门放行",
          "request": {
            "method": "POST",
            "path": "/api/kernel/sessions/s-steer/runs/run-steer-1/gates/<GATE_ID:g3>",
            "headers": { "x-coda-token": "<TOKEN>" },
            "body": { "action": "continue" }
          },
          "response": { "status": 200, "body": { "accepted": true } }
        },
        {
          "afterSeq": 31,
          "note": "Turn 2 完成后 afterTurn 闸门放行，队列中仍有第二条 steer 触发 Turn 3",
          "request": {
            "method": "POST",
            "path": "/api/kernel/sessions/s-steer/runs/run-steer-1/gates/<GATE_ID:g4>",
            "headers": { "x-coda-token": "<TOKEN>" },
            "body": { "action": "continue" }
          },
          "response": { "status": 200, "body": { "accepted": true } }
        },
        {
          "afterSeq": 36,
          "note": "Turn 3 beforeModelTurn 闸门放行",
          "request": {
            "method": "POST",
            "path": "/api/kernel/sessions/s-steer/runs/run-steer-1/gates/<GATE_ID:g5>",
            "headers": { "x-coda-token": "<TOKEN>" },
            "body": { "action": "continue" }
          },
          "response": { "status": 200, "body": { "accepted": true } }
        },
        {
          "afterSeq": 44,
          "note": "Turn 3 工具结果提交以闭合 batch-2",
