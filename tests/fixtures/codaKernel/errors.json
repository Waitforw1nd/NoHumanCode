              { "seq": 17, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "usage", "usage": { "input": 1180, "output": 16, "cacheRead": 768, "cacheWrite": 0, "totalTokens": 1196 } } },
              { "seq": 18, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "entry", "revision": 7, "entry": { "id": "<ENTRY_ID:a2>", "parentId": "<ENTRY_ID:tr1>", "timestamp": "<TS>", "type": "message", "role": "assistant", "content": [{ "type": "text", "text": "已读取 README.md。" }], "metadata": { "stopReason": "stop", "responseId": "<OPAQUE>" } } } },
              { "seq": 19, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "entry", "revision": 8, "entry": { "id": "<ENTRY_ID:usage2>", "parentId": "<ENTRY_ID:a2>", "timestamp": "<TS>", "type": "usage", "category": "chat", "model": { "modelId": "gpt-5.2" }, "usage": { "input": 1180, "output": 16, "cacheRead": 768, "cacheWrite": 0, "totalTokens": 1196 } } } },
              { "seq": 20, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "done", "reason": "completed", "stopReason": "stop", "leafId": "<ENTRY_ID:usage2>", "userEntryId": "<ENTRY_ID:u1>", "assistantEntryId": "<ENTRY_ID:a2>", "revision": 8 } }
            ]
          }
        },
        {
          "afterSeq": 10,
          "note": "宿主提交 call_err_1 结果以完成 run-err-1",
          "request": {
            "method": "POST",
            "path": "/api/kernel/sessions/s-err/runs/run-err-1/tool-results",
            "headers": { "x-coda-token": "<TOKEN>" },
            "body": {
              "callId": "call_err_1",
              "result": { "content": [{ "type": "text", "text": "# Demo" }], "details": null, "isError": false }
            }
          },
          "response": { "status": 202, "body": { "accepted": true } }
        }
      ],
      "response": {
        "status": 200,
        "sse": [
          { "seq": 1, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "status", "state": "running" } },
