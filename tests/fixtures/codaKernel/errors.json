              { "seq": 10, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "status", "state": "waitingTools" } },
              { "seq": 11, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "toolResult", "callId": "call_err_1", "result": { "content": [{ "type": "text", "text": "# Demo" }], "details": null, "isError": false } } },
              { "seq": 12, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "entry", "revision": 6, "entry": { "id": "<ENTRY_ID:tr1>", "parentId": "<ENTRY_ID:usage1>", "timestamp": "<TS>", "type": "toolResult", "callId": "call_err_1", "name": "read", "content": [{ "type": "text", "text": "# Demo" }], "isError": false } } },
              { "seq": 13, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "status", "state": "running" } },
              { "seq": 14, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "contextUsage", "tokens": 1180, "contextWindow": 400000 } },
