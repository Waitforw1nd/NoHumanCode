{
  "name": "errors",
  "description": "覆盖 §9 核心错误码与自愈闭环：404 SESSION_NOT_FOUND 水合恢复、409 SESSION_DIVERGED 失配自愈、严格解析/未知工具/不支持协议 400、活跃 Run 期间 409 RUN_ACTIVE 与 409 RUN_EXISTS 重连回放、401/409 MODEL_PROXY_REJECTED 不重试，以及 410 EVENTS_EXPIRED。",
  "steps": [
    {
      "note": "场景 1：会话未创建或空闲淘汰，返回 404 SESSION_NOT_FOUND（retryable=true）",
      "request": { "method": "GET", "path": "/api/kernel/sessions/s-err", "headers": { "x-coda-token": "<TOKEN>" } },
      "response": { "status": 404, "body": { "error": { "code": "SESSION_NOT_FOUND", "message": "<ANY>", "retryable": true } } }
    },
    {
      "note": "宿主收到 404 后通过 PUT 水合会话",
      "request": {
        "method": "PUT",
        "path": "/api/kernel/sessions/s-err",
        "headers": { "x-coda-token": "<TOKEN>" },
        "body": {
          "cwd": "C:/Users/me/.coda/cd-1f2e",
          "systemPrompt": "你是 Coda。",
          "model": { "modelId": "gpt-5.2", "protocol": "openai-responses", "contextWindow": 400000, "maxOutputTokens": 128000, "thinkingLevel": "medium" },
          "tools": [
            { "name": "read", "description": "读取工作区文件", "parameters": { "type": "object", "properties": { "path": { "type": "string" } }, "required": ["path"] }, "label": "读取文件", "executionMode": "parallel" },
            { "name": "shell", "description": "执行命令", "parameters": { "type": "object", "properties": { "command": { "type": "string" } }, "required": ["command"] }, "label": "命令", "executionMode": "sequential" }
          ],
          "activeToolNames": ["read"],
          "compaction": { "enabled": true, "keepRecentTokens": 20000 },
          "steeringMode": "one-at-a-time",
          "gates": [],
          "history": {
            "leafId": "e-0001",
            "entries": [
              { "id": "e-0001", "parentId": null, "timestamp": "2026-11-27T01:00:00+08:00", "type": "message", "role": "user", "content": [{ "type": "text", "text": "你好" }] }
            ]
          }
        }
      },
      "response": { "status": 201, "body": { "sessionId": "s-err", "revision": 1, "leafId": "e-0001", "status": "idle" } }
    },
    {
      "note": "水合后重试查询成功",
      "request": { "method": "GET", "path": "/api/kernel/sessions/s-err", "headers": { "x-coda-token": "<TOKEN>" } },
      "response": { "status": 200, "body": { "sessionId": "s-err", "revision": 1, "leafId": "e-0001", "status": "idle", "activeToolNames": ["read"] } }
    },
    {
      "note": "场景 2：携带过期 baseRevision 触发 409 SESSION_DIVERGED（retryable=true，附当前 revision 与 leafId）",
      "request": {
        "method": "POST",
        "path": "/api/kernel/sessions/s-err/entries",
        "headers": { "x-coda-token": "<TOKEN>" },
        "body": {
          "baseRevision": 0,
          "entry": { "type": "customMessage", "name": "codaNote", "content": [{ "type": "text", "text": "自愈水合后重试追加" }], "display": true },
          "deliverAs": "append"
        }
      },
      "response": {
        "status": 409,
        "body": { "error": { "code": "SESSION_DIVERGED", "message": "<ANY>", "retryable": true, "details": { "revision": 1, "leafId": "e-0001" } } }
      }
    },
    {
      "note": "宿主以本地 JSONL 权威历史重新 PUT 水合（覆盖返回 200，revision 重置为 1）",
      "request": {
        "method": "PUT",
        "path": "/api/kernel/sessions/s-err",
        "headers": { "x-coda-token": "<TOKEN>" },
        "body": {
          "cwd": "C:/Users/me/.coda/cd-1f2e",
          "systemPrompt": "你是 Coda。",
          "model": { "modelId": "gpt-5.2", "protocol": "openai-responses", "contextWindow": 400000, "maxOutputTokens": 128000, "thinkingLevel": "medium" },
          "tools": [
            { "name": "read", "description": "读取工作区文件", "parameters": { "type": "object", "properties": { "path": { "type": "string" } }, "required": ["path"] }, "label": "读取文件", "executionMode": "parallel" },
            { "name": "shell", "description": "执行命令", "parameters": { "type": "object", "properties": { "command": { "type": "string" } }, "required": ["command"] }, "label": "命令", "executionMode": "sequential" }
          ],
          "activeToolNames": ["read"],
          "compaction": { "enabled": true, "keepRecentTokens": 20000 },
          "steeringMode": "one-at-a-time",
          "gates": [],
          "history": {
            "leafId": "e-0002",
            "entries": [
              { "id": "e-0001", "parentId": null, "timestamp": "2026-11-27T01:00:00+08:00", "type": "message", "role": "user", "content": [{ "type": "text", "text": "你好" }] },
              { "id": "e-0002", "parentId": "e-0001", "timestamp": "2026-11-27T01:00:02+08:00", "type": "message", "role": "assistant", "content": [{ "type": "text", "text": "你好！" }], "metadata": { "stopReason": "stop" } }
            ]
          }
        }
      },
      "response": { "status": 200, "body": { "sessionId": "s-err", "revision": 1, "leafId": "e-0002", "status": "idle" } }
    },
    {
      "note": "重新水合后以最新 baseRevision=1 重试追加成功",
      "request": {
        "method": "POST",
        "path": "/api/kernel/sessions/s-err/entries",
        "headers": { "x-coda-token": "<TOKEN>" },
        "body": {
          "baseRevision": 1,
          "entry": { "type": "customMessage", "name": "codaNote", "content": [{ "type": "text", "text": "自愈水合后重试追加" }], "display": true },
          "deliverAs": "append"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "entry": { "id": "<ENTRY_ID:e3>", "parentId": "e-0002", "timestamp": "<TS>", "type": "customMessage", "name": "codaNote", "content": [{ "type": "text", "text": "自愈水合后重试追加" }], "display": true },
          "revision": 2,
          "leafId": "<ENTRY_ID:e3>"
        }
      }
    },
    {
      "note": "场景 5a：严格解析拒绝多余未知字段，返回 400 INVALID_REQUEST",
      "request": {
        "method": "PATCH",
        "path": "/api/kernel/sessions/s-err",
        "headers": { "x-coda-token": "<TOKEN>" },
        "body": { "unknownField": true }
      },
      "response": { "status": 400, "body": { "error": { "code": "INVALID_REQUEST", "message": "<ANY>", "retryable": false } } }
    },
    {
      "note": "场景 5b：启用未在 tools 中声明的工具名，返回 400 UNKNOWN_TOOL",
      "request": {
        "method": "PUT",
        "path": "/api/kernel/sessions/s-err/active-tools",
        "headers": { "x-coda-token": "<TOKEN>" },
        "body": { "activeToolNames": ["read", "nonExistentTool"] }
      },
      "response": { "status": 400, "body": { "error": { "code": "UNKNOWN_TOOL", "message": "<ANY>", "retryable": false } } }
    },
    {
      "note": "场景 5c：使用能力列表外的 modelProxy.protocol，返回 400 UNSUPPORTED_PROTOCOL",
      "request": {
        "method": "POST",
        "path": "/api/kernel/sessions/s-err/runs",
        "headers": { "x-coda-token": "<TOKEN>" },
        "body": {
          "runId": "run-bad-proto",
          "baseRevision": 2,
          "model": { "modelId": "gpt-5.2" },
          "content": [{ "type": "text", "text": "测试不支持的协议" }],
          "modelProxy": { "baseUrl": "http://127.0.0.1:61234/m/run-bad-proto", "token": "<PROXY_TOKEN_BAD>", "protocol": "unknown-proto" }
        }
      },
      "response": { "status": 400, "body": { "error": { "code": "UNSUPPORTED_PROTOCOL", "message": "<ANY>", "retryable": false } } }
    },
    {
      "note": "场景 3 & 4：活跃 Run 期间并发触发 409 RUN_ACTIVE（PUT 水合与不同 runId 的 POST /runs）、409 RUN_EXISTS（同 runId 重放），随后经 GET /events?after=2 重连回放 seq >= 3",
      "request": {
        "method": "POST",
        "path": "/api/kernel/sessions/s-err/runs",
        "headers": { "x-coda-token": "<TOKEN>" },
        "body": {
          "runId": "run-err-1",
          "baseRevision": 2,
          "model": { "modelId": "gpt-5.2" },
          "content": [{ "type": "text", "text": "读取 README.md" }],
          "thinkingLevel": "medium",
          "maxRequests": 64,
          "modelProxy": { "baseUrl": "http://127.0.0.1:61234/m/run-err-1", "token": "<PROXY_TOKEN_1>", "protocol": "openai-responses" }
        }
      },
      "expectUpstream": [
        {
          "method": "POST",
          "url": "http://127.0.0.1:61234/m/run-err-1/responses",
          "headers": { "authorization": "Bearer <PROXY_TOKEN_1>" },
          "bodyIncludes": { "model": "gpt-5.2", "stream": true }
        },
        {
          "method": "POST",
          "url": "http://127.0.0.1:61234/m/run-err-1/responses",
          "headers": { "authorization": "Bearer <PROXY_TOKEN_1>" },
          "bodyIncludes": { "model": "gpt-5.2", "stream": true }
        }
      ],
      "interactions": [
        {
          "afterSeq": 10,
          "note": "活跃 Run 期间禁止 PUT 水合，返回 409 RUN_ACTIVE",
          "request": {
            "method": "PUT",
            "path": "/api/kernel/sessions/s-err",
            "headers": { "x-coda-token": "<TOKEN>" },
            "body": {
              "cwd": "C:/Users/me/.coda/cd-1f2e",
              "systemPrompt": "你是 Coda。",
              "model": { "modelId": "gpt-5.2", "protocol": "openai-responses", "contextWindow": 400000, "maxOutputTokens": 128000, "thinkingLevel": "medium" },
              "tools": [
                { "name": "read", "description": "读取工作区文件", "parameters": { "type": "object", "properties": { "path": { "type": "string" } }, "required": ["path"] }, "label": "读取文件", "executionMode": "parallel" }
              ],
              "activeToolNames": ["read"],
              "compaction": { "enabled": true, "keepRecentTokens": 20000 },
              "steeringMode": "one-at-a-time",
              "gates": [],
              "history": { "leafId": "e-0002", "entries": [] }
            }
          },
          "response": { "status": 409, "body": { "error": { "code": "RUN_ACTIVE", "message": "<ANY>", "retryable": false } } }
        },
        {
          "afterSeq": 10,
          "note": "活跃 Run 期间以不同 runId 启动第二个 Run，返回 409 RUN_ACTIVE",
          "request": {
            "method": "POST",
            "path": "/api/kernel/sessions/s-err/runs",
            "headers": { "x-coda-token": "<TOKEN>" },
            "body": {
              "runId": "run-err-other",
              "baseRevision": 5,
              "model": { "modelId": "gpt-5.2" },
              "content": [{ "type": "text", "text": "另一个并发 Run" }],
              "modelProxy": { "baseUrl": "http://127.0.0.1:61234/m/run-err-other", "token": "<PROXY_TOKEN_OTHER>", "protocol": "openai-responses" }
            }
          },
          "response": { "status": 409, "body": { "error": { "code": "RUN_ACTIVE", "message": "<ANY>", "retryable": false } } }
        },
        {
          "afterSeq": 10,
          "note": "重复以相同 runId 发起 POST /runs，返回 409 RUN_EXISTS，提示宿主改用 /events 重连",
          "request": {
            "method": "POST",
            "path": "/api/kernel/sessions/s-err/runs",
            "headers": { "x-coda-token": "<TOKEN>" },
            "body": {
              "runId": "run-err-1",
              "baseRevision": 2,
              "model": { "modelId": "gpt-5.2" },
              "content": [{ "type": "text", "text": "读取 README.md" }],
              "modelProxy": { "baseUrl": "http://127.0.0.1:61234/m/run-err-1", "token": "<PROXY_TOKEN_1>", "protocol": "openai-responses" }
            }
          },
          "response": { "status": 409, "body": { "error": { "code": "RUN_EXISTS", "message": "<ANY>", "retryable": false } } }
        },
        {
          "afterSeq": 10,
          "note": "宿主通过 GET /events?after=2 重连，回放 seq >= 3 并继续接收后续实时事件直到 done",
          "request": {
            "method": "GET",
            "path": "/api/kernel/sessions/s-err/runs/run-err-1/events?after=2",
            "headers": { "x-coda-token": "<TOKEN>" }
          },
          "response": {
            "status": 200,
            "sse": [
              { "seq": 3, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "userMessage", "entryId": "<ENTRY_ID:u1>" } },
              { "seq": 4, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "contextUsage", "tokens": 1050, "contextWindow": 400000 } },
              { "seq": 5, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "start", "model": { "modelId": "gpt-5.2" }, "entryId": "<ENTRY_ID:a1>" } },
              { "seq": 6, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "toolCall", "callId": "call_err_1", "name": "read", "args": { "path": "README.md" }, "batchId": "batch-1", "batchIndex": 0, "batchSize": 1 } },
              { "seq": 7, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "usage", "usage": { "input": 1050, "output": 28, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 1078 } } },
              { "seq": 8, "sessionId": "s-err", "runId": "run-err-1", "event": { "type": "entry", "revision": 4, "entry": { "id": "<ENTRY_ID:a1>", "parentId": "<ENTRY_ID:u1>", "timestamp": "<TS>", "type": "message", "role": "assistant", "content": [{ "type": "toolCall", "callId": "call_err_1", "name": "read", "args": { "path": "README.md" } }], "metadata": { "stopReason": "toolUse", "responseId": "<OPAQUE>" } } } },
